# GPU variant for RTX 50-series / CUDA 12.8. The CPU Dockerfile remains unchanged.
FROM nvidia/cuda:12.8.0-devel-ubuntu22.04 AS cuda_toolkit

FROM geoview-runtime:split-clean

WORKDIR /app

ENV STANDALONE_MODE=1 \
    DB_BACKEND=sqlite \
    SQLITE_PATH=/app/runtime_data/jiangxi.sqlite3 \
    CONFIG_PATH=/app/docker/standalone/config.standalone.yaml \
    CSV_PATH=/app/runtime_data/Mine.csv \
    MINER_DEFAULT_GEO_SOURCE_PATH=/app/runtime_data/348个图斑.shp \
    MINER_DEFAULT_KMZ_PATH=/app/runtime_data/Jiangxi_NaturalMine.kmz \
    MINER_ECOLOGY_WORKBOOK_PATH=/app/miner/data/348图斑_TableMERNet无图像预测结果.xlsx \
    GEOVIEW_BACKEND_URL=http://127.0.0.1:5008 \
    MINER_MAP_PROVIDER=gaode \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

COPY backend /app/backend
COPY frontend /app/frontend
COPY miner /app/miner
COPY docker /app/docker
COPY config.yaml /app/config.yaml
COPY docker/standalone/runtime_data /app/runtime_data

# MMCV has no matching pre-built extension for this PyTorch/CUDA pair, so use
# only the CUDA build toolchain from NVIDIA's development image and compile it.
COPY --from=cuda_toolkit /usr/local/cuda-12.8 /usr/local/cuda-12.8
RUN ln -s /usr/local/cuda-12.8 /usr/local/cuda

# PyTorch 2.7 CUDA 12.8 supports Blackwell. FP32 remains the runtime default.
RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/conda/envs/MMSeg310/bin/pip uninstall -y torch torchvision torchaudio \
    && for attempt in 1 2 3 4 5; do \
         /opt/conda/envs/MMSeg310/bin/pip install --retries 12 --timeout 180 torch==2.7.0 torchvision==0.22.0 --index-url https://download.pytorch.org/whl/cu128 \
         && break; \
         echo "[gpu-build] PyTorch CUDA download failed (attempt ${attempt}/5); retrying..." >&2; \
         [ "${attempt}" = "5" ] && exit 1; \
         sleep 15; \
       done \
    && /opt/conda/envs/MMSeg310/bin/python -c "import torch; assert torch.version.cuda == '12.8', torch.version.cuda; print('PyTorch CUDA runtime:', torch.__version__)"

RUN /opt/conda/envs/MMSeg310/bin/pip uninstall -y mmcv mmcv-lite \
    && /opt/conda/envs/MMSeg310/bin/pip install --no-cache-dir "setuptools<81" ninja psutil \
    && CUDA_HOME=/usr/local/cuda MAX_JOBS=2 FORCE_CUDA=1 /opt/conda/envs/MMSeg310/bin/pip install --no-cache-dir --no-build-isolation mmcv==2.1.0 \
    && /opt/conda/envs/MMSeg310/bin/python -c "import mmcv, mmengine, mmseg, torch; assert torch.version.cuda == '12.8', torch.version.cuda; print('GPU runtime packages:', torch.__version__, mmcv.__version__, mmengine.__version__, mmseg.__version__)"

RUN /opt/conda/envs/MMSeg310/bin/python -c "import mmdet; print('MMSeg compatibility:', mmdet.__version__)"

RUN chmod +x /app/docker/entrypoint.sh /app/docker/*.sh /app/docker/standalone/*.sh \
    && mkdir -p /var/lib/jiangxi-standalone /app/runtime_data

EXPOSE 4000 5008

HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD ["/app/docker/standalone/healthcheck.sh"]

ENTRYPOINT ["/app/docker/standalone/start-jiangxi-standalone.sh"]
