# Replace every password placeholder before deployment. Do not commit the resulting .env file.
APP_IMAGE=geoview-runtime:split-clean
MYSQL_IMAGE=registry.openanolis.cn/openanolis/mysql:8.0.30-8.6
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SECRET_KEY=replace-with-a-random-secret-key
MYSQL_DATABASE=geoview
MYSQL_USERNAME=geoview
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MINER_DEFAULT_GEO_SOURCE_PATH=/app/runtime_data/348个图斑.shp
MINER_DEFAULT_KMZ_PATH=/app/runtime_data/Jiangxi_NaturalMine.kmz
MINER_INFERENCE_DATA_ROOT=/app/backend/bianhua_2years
# TableMERNet 生态诊断工作簿。默认使用镜像内置文件；Compose 可将它指向 /app/miner/data 下的受控挂载文件。
MINER_ECOLOGY_WORKBOOK_PATH=/app/miner/data/348图斑_TableMERNet无图像预测结果.xlsx
